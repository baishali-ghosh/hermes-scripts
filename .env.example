# ============================================================
# hermes-scripts -- Environment Variables Template
# Copy this file to .env and fill in your values.
# .env is gitignored and will NEVER be committed.

# -- news/daily_news.py --------------------------------------
NEWS_MAX_ITEMS=4
# RSS feed URLs (built-in defaults shown, override as needed)
NEWS_FEED_WORLD=https://feeds.bbci.co.uk/news/world/rss.xml
NEWS_FEED_TECH=https://feeds.bbci.co.uk/news/technology/rss.xml
NEWS_FEED_BUSINESS=https://feeds.bbci.co.uk/news/business/rss.xml
NEWS_FEED_AI=https://www.sciencedaily.com/rss/computers_math/artificial_intelligence.xml
# Optional: NewsAPI.org key (free = 100 req/day)
# Sign up at https://newsapi.org/register
NEWSAPI_KEY=
NEWSAPI_COUNTRY=us
