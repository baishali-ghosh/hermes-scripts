# ============================================================
# hermes-scripts -- Environment Variables Template
# Copy this file to .env and fill in your values.
# .env is gitignored and will NEVER be committed.
# ============================================================

# -- news/daily_news.py --------------------------------------
NEWS_MAX_ITEMS=5

# RSS feed URLs (built-in defaults shown, override as needed)
NEWS_FEED_INDIA=https://feeds.bbci.co.uk/news/world/asia/india/rss.xml
NEWS_FEED_TECH=https://techcrunch.com/feed/
NEWS_FEED_AI=https://www.artificialintelligence-news.com/feed/
NEWS_FEED_FINANCE_IN=https://economictimes.indiatimes.com/markets/rssfeeds/1977021501.cms
NEWS_FEED_FINANCE_WORLD=https://feeds.bbci.co.uk/news/business/rss.xml

# Optional: NewsAPI.org key (free = 100 req/day)
# Sign up at https://newsapi.org/register
NEWSAPI_KEY=
NEWSAPI_COUNTRY=in

